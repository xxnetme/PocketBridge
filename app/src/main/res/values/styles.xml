<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/pb_bg</item>
    <item name="android:colorBackground">@color/pb_surface</item>
    <item name="android:colorPrimary">@color/pb_accent</item>
    <item name="android:colorPrimaryDark">@color/pb_bg</item>
    <item name="android:colorAccent">@color/pb_accent</item>
    <item name="android:statusBarColor">@color/pb_bg</item>
    <item name="android:navigationBarColor">@color/pb_bg</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

  <style name="AppDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:colorBackground">@color/pb_dialog</item>
    <item name="android:colorPrimary">@color/pb_accent</item>
    <item name="android:colorAccent">@color/pb_accent</item>
  </style>
</resources>
